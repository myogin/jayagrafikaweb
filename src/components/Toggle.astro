---
interface Props {
  name: string;
  label: string;
}
const { name, label } = Astro.props;
---

<label class="col-span-2 flex min-h-11 cursor-pointer items-center gap-3 text-sm font-medium text-ink">
  <input type="checkbox" name={name} class="size-5 cursor-pointer rounded accent-brand" />
  {label}
</label>
